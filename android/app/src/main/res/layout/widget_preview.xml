<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- ═══ 1. Top Section: Day in Thuluth Calligraphy + Time & Hijri/Gregorian beside it ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <!-- Day of the Week in Authentic Thuluth Font (خط الثلث) — no clip, full Tashkeel visible -->
        <TextView
            android:id="@+id/widget_preview_day_calligraphy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/thuluth"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="السَّبْت"
            android:textColor="#FFFFFF"
            android:textSize="62sp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <!-- Info Beside Day: Current Time + Hijri + Gregorian Dates (Somar Sans) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical|start"
            android:orientation="vertical">

            <!-- Current Time in Somar Sans Bold -->
            <TextView
                android:id="@+id/widget_preview_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somarsans_bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="08:30 م"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <!-- Hijri Date in Somar Sans Medium -->
            <TextView
                android:id="@+id/widget_preview_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/somarsans_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="٢٩ ربيع الأول ١٤٤٨ هـ"
                android:textColor="#F3F4F6"
                android:textSize="13sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <!-- Gregorian Date in Somar Sans Regular -->
            <TextView
                android:id="@+id/widget_preview_gregorian_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/somarsans_regular"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="السبت، ١٢ سبتمبر"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ 2. 6 Prayers Horizontal Row (RTL: Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha) in Somar Sans ═══ -->
    <LinearLayout
        android:id="@+id/widget_preview_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:weightSum="6">

        <!-- 1. Fajr (الفجر) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somarsans_medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="الفجر"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/somarsans_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="5:10"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- 2. Sunrise (الشروق) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somarsans_medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="الشروق"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/somarsans_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="6:38"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- 3. Dhuhr (الظهر) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somarsans_medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="الظهر"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/somarsans_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="12:51"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- 4. Asr (العصر) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somarsans_medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="العصر"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/somarsans_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="4:23"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- 5. Maghrib (المغرب) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somarsans_medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="المغرب"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/somarsans_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="7:04"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- 6. Isha (العشاء) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somarsans_medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="العشاء"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/somarsans_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="8:23"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
